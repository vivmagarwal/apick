{
  "name": "@apick/cms",
  "version": "0.3.0",
  "description": "APIck CMS — a full, themable CMS on top of @apick/core: schema-driven admin UI, users & sessions, server-rendered themable frontend, plugins. WordPress-class, headless-first.",
  "license": "MIT",
  "type": "module",
  "author": "Vivek M Agarwal",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "llms.txt",
    "llms-full.txt"
  ],
  "scripts": {
    "build": "node ../../scripts/build-llms.mjs && tsc -p tsconfig.json && node scripts/build-admin.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/admin/ui/tsconfig.json --noEmit"
  },
  "keywords": [
    "cms",
    "headless-cms",
    "admin",
    "wordpress-alternative",
    "themes",
    "apick"
  ],
  "dependencies": {
    "@apick/core": "workspace:*",
    "hono": "^4.12.30",
    "marked": "^15.0.0"
  },
  "peerDependencies": {
    "sharp": "^0.35.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "sharp": "^0.35.0",
    "edodo-write": "^0.9.0",
    "esbuild": "^0.25.0",
    "htm": "^3.1.1",
    "preact": "^10.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "wouter": "^3.3.5",
    "@tanstack/react-query": "^5.62.0",
    "lucide-react": "^0.468.0",
    "cmdk": "^1.0.4",
    "sonner": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/cli": "^4.1.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.2"
  },
  "bin": {
    "apick-cms": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vivmagarwal/apick.git",
    "directory": "packages/cms"
  },
  "homepage": "https://github.com/vivmagarwal/apick/tree/main/packages/cms#readme",
  "bugs": {
    "url": "https://github.com/vivmagarwal/apick/issues"
  }
}
